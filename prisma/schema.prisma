generator client {
  provider = "prisma-client"
  output   = "../apps/web/src/generated/prisma"
}

generator collab_client {
  provider = "prisma-client"
  output   = "../apps/collab/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String          @id
  name          String
  email         String
  emailVerified Boolean         @default(false)
  image         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  sessions      Session[]
  accounts      Account[]
  collections   Collection[]
  categories    Category[]
  notes         Note[]
  noteUserStates NoteUserState[]
  members       Member[]
  invitations   Invitation[]
  boards        Board[]
  databases     Database[]
  agentThreads  AgentThread[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Collection {
  id               String       @id @default(uuid())
  name             String
  slug             String
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId      String
  workspace        Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  resources        Resource[]
  color            String?
  description      String?
  isNoteCollection Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  notes            Note[]

  @@unique([workspaceId, slug])
}

model Resource {
  id           String     @id @default(uuid())
  title        String
  description  String?
  url          String
  iconUrl      String?
  ogImageUrl   String?
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  categories   Category[] @relation("ResourceCategories")
  fetchedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([url, collectionId])
}

model Category {
  id          String       @id @default(uuid())
  name        String
  slug        String
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  resources   Resource[]   @relation("ResourceCategories")

  @@unique([name, workspaceId])
  @@unique([slug, workspaceId])
}

model Note {
  id           String       @id @default(uuid())
  title        String
  icon         String?
  content      Json         @default("{\"type\":\"doc\",\"content\":[]}")
  collectionId String?
  collection   Collection?  @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId  String
  workspace    Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ydoc         Bytes?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  linkedTo       NoteLink[]      @relation("source")
  linkedFrom     NoteLink[]      @relation("target")
  userStates     NoteUserState[]
}

/// Estado por usuário (favorito + recente). Pessoal — não compartilha entre membros.
model NoteUserState {
  userId       String
  noteId       String
  isFavorite   Boolean   @default(false)
  favoritedAt  DateTime?
  lastOpenedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([userId, noteId])
  @@index([userId, isFavorite, favoritedAt])
  @@index([userId, lastOpenedAt])
  @@map("note_user_state")
}

model NoteLink {
  sourceId  String
  targetId  String
  source    Note     @relation("source", fields: [sourceId], references: [id], onDelete: Cascade)
  target    Note     @relation("target", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([sourceId, targetId])
}

model Organization {
  id          String               @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  collections Collection[]
  categories  Category[]
  notes       Note[]
  boards      Board[]
  databases   Database[]
  aiSettings  WorkspaceAiSettings?

  @@unique([slug])
  @@map("organization")
}

model WorkspaceAiSettings {
  workspaceId    String       @id
  workspace      Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  defaultModelId String       @default("claude-sonnet-4-6")
  systemPrompt   String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("workspace_ai_settings")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model Board {
  id          String       @id @default(uuid())
  title       String
  description String?
  icon        String?
  workspaceId String
  workspace   Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  lastOpenedAt DateTime?

  @@index([workspaceId])
  @@index([createdById])
  @@index([lastOpenedAt])
}

/// Database block / table (Yjs-backed). Soft-deletable workspace resource.
model Database {
  id          String         @id @default(uuid())
  name        String
  icon        String?
  description String?
  workspaceId String
  workspace   Organization   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  properties  Json           @default("[]")
  ydoc        Bytes          @default("")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  rows        DatabaseRow[]

  @@index([workspaceId])
  @@index([createdById])
}

model DatabaseRow {
  id         String   @id @default(uuid())
  databaseId String
  database   Database @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  values     Json     @default("{}")
  position   Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([databaseId])
}
