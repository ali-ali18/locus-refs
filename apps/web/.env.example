# Database
DATABASE_URL=postgresql://user:password@localhost:5432/refstash

# Auth
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:3000

# Storage (S3-compatible)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=

# Collaboration (Hocuspocus)
NEXT_PUBLIC_COLLAB_WS_URL=ws://localhost:1234
COLLAB_JWT_SECRET=

# Tldraw sync (Cloudflare Worker)
# Em dev: rode `pnpm --filter tldraw-sync dev` (porta 8787)
# Em prod: custom domain do Worker
NEXT_PUBLIC_TLDRAW_SYNC_WS_URL=ws://127.0.0.1:8787
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# AI — pelo menos uma chave é obrigatória
ANTHROPIC_API_KEY=sk-ant-...

MINIMAX_API_KEY=
