# PostgreSQL (mesmo do web — membership no join, Passo 3+)
DATABASE_URL=postgresql://user:password@localhost:5432/refstash

# Redis (adapter Socket.io + pub/sub kanban:events)
# Em prod: URL da instância Redis externa (não sobe no container do realtime)
REDIS_URL=redis://127.0.0.1:6379

# JWT do handshake Socket.io (mesmo secret no web para emitir o token)
# Gera: openssl rand -base64 32
REALTIME_JWT_SECRET=

# Porta HTTP + Socket.io
PORT=4001
